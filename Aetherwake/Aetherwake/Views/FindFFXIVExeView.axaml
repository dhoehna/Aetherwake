<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Aetherwake.Views.FindFFXIVExeView"
             xmlns:vm="using:Aetherwake.ViewModels"
             x:DataType="vm:FindFFXIVViewModel">
  <Grid
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Width="800"
    Height="450">
	  <Button Content="Locate ffxiv__dx11.exe"
              Command="{Binding FindFFXIVExe}"
              IsEnabled="{Binding !IsSearchingForExe}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
  </Grid>
</UserControl>
